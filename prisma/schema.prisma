generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
}

enum NotificationType {
  MEMBER_ASSIGNED
  MEMBER_REVOKED
  FLOWER_IMPORT_COMPLETED
  FLOWER_IMPORT_PARTIAL
  USER_PENDING_MEMBER_ASSIGNMENT
}

model Flower {
  id          String   @id @default(cuid())
  name        String
  price       Int
  imageUrl    String
  description String?
  stock       Int      @default(0)
  category    String?
  color       String?
  gameItemId  String?
  rarity      String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owners FlowerOwner[]

  @@index([name])
  @@index([category])
  @@index([createdAt])
  @@index([isActive, sortOrder])
}

model Member {
  id          String   @id @default(cuid())
  displayName String
  gameHandle  String?
  avatarUrl   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  flowers     FlowerOwner[]
  userMembers UserMember[]

  @@index([displayName])
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  members               UserMember[]
  notifications         Notification[] @relation("NotificationRecipient")
  targetedNotifications Notification[] @relation("NotificationTargetUser")

  @@index([username])
}

model FlowerOwner {
  id        String   @id @default(cuid())
  flowerId  String
  memberId  String
  ownedAt   DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flower Flower @relation(fields: [flowerId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([flowerId, memberId])
  @@index([memberId])
}

model UserMember {
  id        String   @id @default(cuid())
  userId    String
  memberId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([userId, memberId])
  @@index([memberId])
}

model Notification {
  id           String           @id @default(cuid())
  userId       String
  targetUserId String?
  type         NotificationType
  title        String
  message      String
  linkUrl      String?
  isRead       Boolean          @default(false)
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())

  user       User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  targetUser User? @relation("NotificationTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@index([type, targetUserId, resolvedAt])
  @@unique([userId, type, targetUserId])
}
